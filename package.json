{
  "name": "@jorisjonkers-dev/auth-ui",
  "type": "module",
  "version": "0.7.2",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "license": "LicenseRef-JorisJonkers-Proprietary-1.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "stryker": "stryker run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm depcruise && pnpm build"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.13.0",
    "@grafana/faro-web-tracing": "2.13.0",
    "@jorisjonkers-dev/auth-api-client": "0.9.0",
    "@jorisjonkers-dev/vue-web-commons": "0.4.1",
    "pinia": "3.0.4",
    "primevue": "4.5.5",
    "qrcode": "1.5.4",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "2.5.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
